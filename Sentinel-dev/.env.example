# Valeurs de DÉVELOPPEMENT. À changer avant la démo / sur le serveur.
# fichier a ne pas etre partagé sur git /gitignore/
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=sentinel_password_dev

# Clé que les appareils doivent envoyer (en-tête "x-api-key") pour écrire par HTTP
API_KEY=sentinel-dev-key-change-me

DASHBOARD_PORT=8080

# MQTT : port du broker, et identifiants (laisser vide tant que la Cyber n'a pas activé l'authentification)
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# Nom d'appareil donné aux mesures MQTT qui n'en contiennent pas
DEFAULT_DEVICE_ID=ESP001
