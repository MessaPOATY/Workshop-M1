{
  "name": "sentinel-x-api",
  "version": "2.0.0",
  "description": "API Sentinel-X : reçoit les mesures et alertes (MQTT et HTTP), les stocke, les sert au dashboard",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
