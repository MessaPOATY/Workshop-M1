    "simulate:mqtt": "node scripts/simulator-mqtt.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "express": "^4.21.2",
    "mqtt": "^5.10.1",
    "pg": "^8.13.1"
  }
}
